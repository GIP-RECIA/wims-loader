{# templates/web/debug.html.twig #}
{% extends 'base.html.twig' %}

{% block general_body %}

<h1>{{ "debug.title"|trans }}</h1>

{% if content is defined %}
    {{ content|raw }}
{% endif %}

{% if dumpArray is defined %}
    {% for key, value in dumpArray %}
        <h2>{{ key }}</h2>
        <pre>{{ value|json_encode(constant('JSON_PRETTY_PRINT')) }}</pre>
    {% endfor %}
{% endif %}

{% endblock %}